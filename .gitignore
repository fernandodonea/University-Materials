*.dSYM/

# Many Linux/macOS executables are extensionless; keep them out of common build dirs
# Ignore typical build/output directories entirely (but allow an optional .gitkeep to keep the dir in git)
bin/**
obj/**
build/**
Build/**
dist/**
out/**
target/**
Debug/**
Release/**
x64/**
x86/**
!bin/.gitkeep
!obj/.gitkeep
!build/.gitkeep
!Build/.gitkeep
!dist/.gitkeep
!out/.gitkeep
!target/.gitkeep
!Debug/.gitkeep
!Release/.gitkeep
!x64/.gitkeep
!x86/.gitkeep

# Common default executable names
a.out

# OS metadata (not executables, but safe to ignore and commonly annoying)
.DS_Store
Icon?
Thumbs.db
ehthumbs.db
Desktop.ini

